# LaTeX intermediate files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.bbl
*.blg
*.run.xml
*.xdv

build/

# PDFs generated by the build (keep source images like .jpg/.png)
pdf/src/main.pdf
pdf/build/
!/images/*.jpg
!/images/*.png
# if you want to keep some PDFs, remove or override these lines

# Build and helper directories/logs
build/*.log
build/latexmk.log
build/pdflatex.log

# Generated chapter input
pdf/src/chapters/_auto_inputs.tex
pdf/src/full_cookbook.tex

# Generated recipe .tex files (generated from TOML via generate_tex.py)
# Ignore recipe .tex files in chapter subdirectories, but keep chapter breaks and intro
pdf/src/chapters/01_sauces/01_*.tex
!pdf/src/chapters/01_sauces/01_00_chapter_break.tex
pdf/src/chapters/02_starters_and_sides/02_*.tex
!pdf/src/chapters/02_starters_and_sides/02_00_chapter_break.tex
pdf/src/chapters/03_mains/03_*.tex
!pdf/src/chapters/03_mains/03_00_chapter_break.tex
pdf/src/chapters/04_special_occaisions/04_*.tex
!pdf/src/chapters/04_special_occaisions/04_0_chapter_break.tex
!pdf/src/chapters/04_special_occaisions/04_0_chapter_break.tex
# Keep intro and sauces chapters
!pdf/src/chapters/00_intro/*.tex
!pdf/src/chapters/01_sauces/*.tex

# Generated image PDFs (placeholders)
images/*.pdf
images/*.aux
images/*.log

# Editor/IDE
.vscode/
.idea/
*.iml

# Temporary / backup files
*~
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# Node deps (if used)
node_modules/

# Python
__pycache__/
*.pyc
*.pyo

# Misc
*.tmp
*.partial

# Generated Markdown files (generated from TOML via generate_md.py)
website/content.en/recipes/**/*.md
website/content.en/recipes/**/*.jpg
website/content.en/recipes/**/_index.md


# Static images (copied from recipe folders during generation)
website/static/images/

# Firebase local cache
website/.firebase/
.firebaserc

# End of file
pdf/src/main.aux

website/public/
website/resources/
**/resources/_gen/
gitleaks-report.json
pdf/src/full_cookbook.tex
pdf/src/full_cookbook_dev.tex
pdf/src/main_dev.pdf
