\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/cookbook}

\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{setspace}
\RequirePackage{fontspec}
\RequirePackage{enumitem}
\RequirePackage{geometry}
\RequirePackage{multicol}
\RequirePackage{xifthen}
\RequirePackage{xcolor}
\RequirePackage{tikz}

% ── Brand colours ────────────────────────────────────────────────────────────
% Swap these out for your final palette.
\definecolor{CoverBg}     {HTML}{1C2B1A}  % dark forest green
\definecolor{CoverAccent} {HTML}{C8A96E}  % warm gold
\definecolor{CoverFg}     {HTML}{F5F0E8}  % off-white

\geometry{top=2cm, bottom=2cm, left=2.5cm, right=2.5cm}
\setstretch{1.1}

\setmainfont{XCharter}

% ── Page layout dimensions ───────────────────────────────────────────────────
\newlength{\fullpageheight}
\newlength{\halfpageheight}
\newlength{\thirdpageheight}

\AtBeginDocument{%
  \setlength{\fullpageheight}{\textheight}%
  \setlength{\halfpageheight}{0.475\textheight}%
  \setlength{\thirdpageheight}{0.30\textheight}%
}

% ── Typography ───────────────────────────────────────────────────────────────
\setlength{\columnsep}{0.8cm}
\setlength{\parskip}{0pt}

% Section = recipe title (full / double layouts)
\titleformat{\section}
  {\normalfont\large\scshape}{\thesection}{1em}{}
\titlespacing*{\section}{0pt}{4pt}{3pt}

% Subsection = Ingredients / Instructions / Hints & Tips
\titleformat{\subsection}
  {\normalfont\small\bfseries}{\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{4pt}{1pt}

% Lists — tight throughout
\setlist{noitemsep, topsep=1pt, parsep=0pt, partopsep=0pt}

% ── Ingredient list ──────────────────────────────────────────────────────────
\newlist{ingredients}{itemize}{1}
\setlist[ingredients]{
  label=\textbullet,
  nosep,
  topsep=1pt,
  leftmargin=1.5em,
  font=\small
}

% ── Header / footer ──────────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\itshape\leftmark}
\fancyhead[RO]{\small\itshape\rightmark}
\fancyfoot[C]{\small\thepage}
\setlength{\headheight}{15pt}
\addtolength{\topmargin}{-3pt}

% ── Recipe separator (between sub-page recipes sharing a page) ────────────────
\newcommand{\recipesep}{%
  \par\vspace{3mm}%
  \noindent\rule{\textwidth}{0.3pt}%
  \vspace{3mm}\par\noindent%
}

% ── Chapter break: image page + title page ───────────────────────────────────
% #1 = chapter name   #2 = image path   #3 = caption (may be empty)
\newcommand{\chapterbreak}[3]{%
  % Image page — full page within margins
  \clearpage
  \thispagestyle{empty}%
  \noindent\includegraphics[%
    width=\textwidth,%
    height=0.93\textheight,%
    keepaspectratio=false]{#2}%
  \ifthenelse{\equal{#3}{}}{}{%
    \par\vspace{4mm}%
    \noindent\small\itshape #3%
  }%
  \clearpage
  % Chapter title page
  \thispagestyle{empty}%
  \addcontentsline{toc}{chapter}{#1}%
  \vspace*{\fill}%
  % ── decorative ornament placeholder ──────────────────────────
  % Replace the tikzpicture below with \includegraphics{your-illustration}
  % or any other content; the vspace above/below will centre it.
  \begin{center}%
    \begin{tikzpicture}
      % Outer rule
      \draw[color=CoverAccent, line width=0.6pt]
        (-4,0) -- (4,0);
      % Diamond centrepiece — placeholder for an illustration
      \filldraw[color=CoverAccent, fill=CoverAccent!15, line width=0.6pt]
        (0, 0.55) -- (0.55, 0) -- (0, -0.55) -- (-0.55, 0) -- cycle;
    \end{tikzpicture}%
    \par\vspace{8mm}%
    {\fontsize{36}{46}\selectfont\scshape #1\par}%
    \vspace{8mm}%
    \begin{tikzpicture}
      \draw[color=CoverAccent, line width=0.6pt]
        (-4,0) -- (4,0);
      \filldraw[color=CoverAccent, fill=CoverAccent!15, line width=0.6pt]
        (0, 0.55) -- (0.55, 0) -- (0, -0.55) -- (-0.55, 0) -- cycle;
    \end{tikzpicture}%
  \end{center}%
  \vspace*{\fill}%
  \clearpage
  \pagestyle{fancy}%
  \markboth{#1}{#1}%
}

% Fallback: chapter title only (no image)
\newcommand{\chapterbreakplain}[1]{%
  \clearpage
  \thispagestyle{empty}%
  \addcontentsline{toc}{chapter}{#1}%
  \vspace*{\fill}%
  \begin{center}%
    \begin{tikzpicture}
      \draw[color=CoverAccent, line width=0.6pt] (-4,0) -- (4,0);
      \filldraw[color=CoverAccent, fill=CoverAccent!15, line width=0.6pt]
        (0, 0.55) -- (0.55, 0) -- (0, -0.55) -- (-0.55, 0) -- cycle;
    \end{tikzpicture}%
    \par\vspace{8mm}%
    {\fontsize{36}{46}\selectfont\scshape #1\par}%
    \vspace{8mm}%
    \begin{tikzpicture}
      \draw[color=CoverAccent, line width=0.6pt] (-4,0) -- (4,0);
      \filldraw[color=CoverAccent, fill=CoverAccent!15, line width=0.6pt]
        (0, 0.55) -- (0.55, 0) -- (0, -0.55) -- (-0.55, 0) -- cycle;
    \end{tikzpicture}%
  \end{center}%
  \vspace*{\fill}%
  \clearpage
  \pagestyle{fancy}%
  \markboth{#1}{#1}%
}

% ── Image pages — full page within margins ───────────────────────────────────
% Full single image.  #1 = image path   #2 = caption (may be empty)
\newcommand{\imagepagefull}[2]{%
  \clearpage
  \thispagestyle{empty}%
  \noindent\includegraphics[%
    width=\textwidth,%
    height=0.93\textheight,%
    keepaspectratio=false]{#1}%
  \ifthenelse{\equal{#2}{}}{}{%
    \par\vspace{4mm}%
    \noindent\small\itshape #2%
  }%
  \clearpage
}

% Split image page (top + bottom). #1/#3 = image paths, #2/#4 = captions
\newcommand{\imagepagesplit}[4]{%
  \clearpage
  \thispagestyle{empty}%
  \noindent\includegraphics[%
    width=\textwidth,%
    height=0.46\textheight,%
    keepaspectratio=false]{#1}%
  \ifthenelse{\equal{#2}{}}{}{%
    \par\vspace{2mm}%
    \noindent\small\itshape #2\par%
  }%
  \vspace{4mm}%
  \noindent\includegraphics[%
    width=\textwidth,%
    height=0.46\textheight,%
    keepaspectratio=false]{#3}%
  \ifthenelse{\equal{#4}{}}{}{%
    \par\vspace{2mm}%
    \noindent\small\itshape #4%
  }%
  \clearpage
}
