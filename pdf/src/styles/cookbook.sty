\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/cookbook}

\RequirePackage{lmodern}
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{setspace}
\RequirePackage{fontspec}
\RequirePackage{enumitem}
\RequirePackage{geometry}
\RequirePackage{multicol}
% \RequirePackage[
%     paperwidth=210mm,
%     paperheight=297mm,
%     margin=20mm,
%     heightrounded
% ]{geometry}

% % 2. Use the crop package to "mount" that A4 on an A3 sheet
% % 'cam' provides the crosshair marks, 'info' adds the filename/date
% \RequirePackage[a3, center, cam, info]{crop}
\geometry{top=2cm, bottom=2cm, left=2cm, right=2cm}
\setstretch{1.2}

\setmainfont{XCharter}

% simple chapter/section formats (safe defaults)
\titleformat{\section}{\huge\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\large\bfseries}{\thesubsection}{1em}{}

% header/footer
\pagestyle{fancy}
\fancyhf{}
% \fancyhead[L]{\leftmark}
\fancyfoot[C]{\thepage}

\setlength{\headheight}{15pt}
\addtolength{\topmargin}{-3pt}  

\setlist{noitemsep, topsep=2pt, parsep=0pt, partopsep=0pt}

\titleformat{\section}
  {\normalfont\Large\scshape} % \scshape triggers Small Caps
  {\thesection}
  {1em}
  {} % Leave this empty so it respects your Title Case input

% Optional: Set the gap between columns
\setlength{\columnsep}{1cm} 

% Create a custom command for a compact ingredient list
\newlist{ingredients}{itemize}{1}
\setlist[ingredients]{
    label=\textbullet,
    nosep,
    leftmargin=1.5em,
    font=\small
}

\newcommand{\minirecipe}[2]{% #1=Title, #2=Content
    \subsection*{#1}
    #2
    \vspace{1em}
    \hrule
    \vspace{1em}
}

\newcommand{\simplerecipe}[2]{% #1=Title, #2=Content
    \clearpage
    \section*{#1}
    #2
    \vfill
    \clearpage
}

\newcommand{\illustratedrecipe}[3]{% #1=Image, #2=Title, #3=Content
    \clearpage
    \thispagestyle{empty}
    \begin{tikzpicture}[remember picture, overlay]
        \node[inner sep=0pt] at (current page.center) {%
            \includegraphics[width=\paperwidth, height=\paperheight]{#1}%
        };
    \end{tikzpicture}
    \newpage
    % The Text Page
    \section*{#2}
    #3
    \clearpage
}

\newenvironment{recipeIngredients}[1]{%
    \subsection*{Ingredients}
    \begin{multicols}{#1}
    \begin{itemize}
}{%
    \end{itemize}
    \end{multicols}
}