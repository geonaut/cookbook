\ProvidesPackage{styles/cookbook}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{tgheros}
\renewcommand{\familydefault}{\sfdefault}

% Layout and graphics
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{caption}
\RequirePackage{tikz}

% A4 two-sided layout suitable for printing/binding
\RequirePackage[a4paper,twoside,inner=25mm,outer=25mm,top=25mm,bottom=25mm]{geometry}

% Simple section/chapter styling (safe defaults)
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\bfseries\Huge\centering}
  {\chaptertitlename\ \thechapter}
  {1ex}
  {}

% Readable paragraph settings
\setlength{\parskip}{0.5\baselineskip}
\setlength{\parindent}{0pt}

% Header/footer: no chapter name in header, page number centered at bottom
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}                    % clear all header/footer fields
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\thepage}       % centered page number

% Ensure plain pages (chapter starts, etc.) also have centered page number and no header
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\thepage}%
}

% Chapter cover macro: prints a centered cover page (no header/footer)
\newcommand{\chapterCover}[1]{%
  \cleardoublepage
  \thispagestyle{empty}%
  \vspace*{\fill}%
  \begin{center}%
    {\normalfont\Huge\bfseries #1\par}%
  \end{center}%
  \vspace*{\fill}%
  \cleardoublepage
}

% Convenience: emit a cover page then the actual numbered chapter
\newcommand{\chapterWithCover}[1]{%
  \chapterCover{#1}%
  \chapter{#1}%
}

% Utility: simple cover include macro (no error if empty)
\newcommand{\cookbookCover}[1][]{%
  \ifx\relax#1\relax
    % no image specified — leave to document
  \else
    \includegraphics[width=\paperwidth,height=\paperheight,keepaspectratio]{#1}%
  \fi
}

\newcommand{\illustratedrecipe}[3]{%
    \clearpage
    \thispagestyle{empty}
    \begin{tikzpicture}[remember picture, overlay]
        \node[inner sep=0pt] at (current page.center) {%
            \includegraphics[width=\paperwidth, height=\paperheight]{#1}%
        };
    \end{tikzpicture}
    \newpage
    \section*{#2}
    #3
    \clearpage
}

