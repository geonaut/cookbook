\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/cookbook}

\RequirePackage{lmodern}
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{setspace}
\RequirePackage{fontspec}
\RequirePackage{enumitem}
\RequirePackage{geometry}
\RequirePackage{multicol}
% \RequirePackage[
%     paperwidth=210mm,
%     paperheight=297mm,
%     margin=20mm,
%     heightrounded
% ]{geometry}

% % 2. Use the crop package to "mount" that A4 on an A3 sheet
% % 'cam' provides the crosshair marks, 'info' adds the filename/date
% \RequirePackage[a3, center, cam, info]{crop}
\geometry{top=2cm, bottom=2cm, left=2cm, right=2cm}
\setstretch{1.2}

\setmainfont{Charter}

% simple chapter/section formats (safe defaults)
\titleformat{\section}{\huge\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\large\bfseries}{\thesubsection}{1em}{}

% header/footer
\pagestyle{fancy}
\fancyhf{}
% \fancyhead[L]{\leftmark}
\fancyfoot[C]{\thepage}

\setlength{\headheight}{15pt}
\addtolength{\topmargin}{-3pt}  

\setlist{noitemsep, topsep=2pt, parsep=0pt, partopsep=0pt}

% Optional: Set the gap between columns
\setlength{\columnsep}{1cm} 

% Create a custom command for a compact ingredient list
\newlist{ingredients}{itemize}{1}
\setlist[ingredients]{
    label=\textbullet,
    nosep,              % Removes space between items
    leftmargin=1.5em,   % Adjusts indentation
    font=\small         % Makes ingredient text slightly smaller
}

% --- 1. MINI RECIPE (2 per page, no photos) ---
% Use this for short items like sauces or dips.
\newcommand{\minirecipe}[2]{% #1=Title, #2=Content
    \subsection*{#1}
    #2
    \vspace{1em}
    \hrule
    \vspace{1em}
}

% --- 2. SIMPLE RECIPE (1 per page, no photo) ---
\newcommand{\simplerecipe}[2]{% #1=Title, #2=Content
    \clearpage
    \section*{#1}
    #2
    \vfill
    \clearpage
}

% --- 3. ILLUSTRATED RECIPE (Full photo + Recipe page) ---
\newcommand{\illustratedrecipe}[3]{% #1=Image, #2=Title, #3=Content
    \clearpage
    % The Photo Page
    \thispagestyle{empty}
    \begin{tikzpicture}[remember picture, overlay]
        \node[inner sep=0pt] at (current page.center) {%
            \includegraphics[width=\paperwidth, height=\paperheight]{#1}%
        };
    \end{tikzpicture}
    \newpage
    % The Text Page
    \section*{#2}
    #3
    \clearpage
}